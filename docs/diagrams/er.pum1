@startuml
!theme plain
skinparam linetype ortho

entity "Admin" as admin {
  * id : INTEGER <<PK>>
  --
  * login : TEXT
  * password : TEXT
}

entity "Sklad" as sklad {
  * id : INTEGER <<PK>>
  --
  * login : TEXT
  * password : TEXT
}

entity "Category" as cat {
  * id : INTEGER <<PK>>
  --
  * name : TEXT
}

entity "Product" as prod {
  * id : INTEGER <<PK>>
  --
  * name : TEXT
  * price : REAL
  * quantity : INTEGER
  * category_id : INTEGER <<FK>>
}

entity "Operation" as op {
  * id : INTEGER <<PK>>
  --
  * product_id : INTEGER <<FK>>
  * sklad_id : INTEGER <<FK>>
  * type : BOOLEAN
  * quantity : INTEGER
  * date : TEXT
}

cat ||--o{ prod : "1:N"
prod ||--o{ op : "1:N"
sklad ||--o{ op : "1:N"

@enduml