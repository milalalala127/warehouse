@startuml
left to right direction

actor "Кладовщик" as Sklad
actor "Администратор" as Admin

rectangle "Система учёта товаров" {
    usecase "Вход в систему" as UC_Login
    
    ' Действия кладовщика
    usecase "Просмотр списка товаров" as UC_View
    usecase "Приход товара" as UC_In
    usecase "Расход товара" as UC_Out
    usecase "Поиск товара по названию" as UC_Search
    
    ' Действия администратора
    usecase "Добавление товара" as UC_Add
    usecase "Удаление товара" as UC_Del
    usecase "Отчёт «мало на складе»" as UC_Report
    usecase "Добавление кладовщика" as UC_AddSklad
}

Sklad -- UC_Login
Admin -- UC_Login

' От входа ко всем действиям
UC_Login -- UC_View
UC_Login -- UC_In
UC_Login -- UC_Out
UC_Login -- UC_Search

UC_Login -- UC_Add
UC_Login -- UC_Del
UC_Login -- UC_Report
UC_Login -- UC_AddSklad

@enduml