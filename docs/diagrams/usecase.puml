@startuml
left to right direction

actor "Storekeeper" as Sklad
actor "Administrator" as Admin

rectangle "Inventory Management System" {
    usecase "Login" as UC_Login
    
    ' Storekeeper actions
    usecase "View product list" as UC_View
    usecase "Receive goods" as UC_In
    usecase "Issue goods" as UC_Out
    usecase "Search product by name" as UC_Search
    
    ' Administrator actions
    usecase "Add product" as UC_Add
    usecase "Delete product" as UC_Del
    usecase "Low stock report" as UC_Report
    usecase "Add storekeeper" as UC_AddSklad
}

Sklad -- UC_Login
Admin -- UC_Login

' From login to all actions
UC_Login -- UC_View
UC_Login -- UC_In
UC_Login -- UC_Out
UC_Login -- UC_Search

UC_Login -- UC_Add
UC_Login -- UC_Del
UC_Login -- UC_Report
UC_Login -- UC_AddSklad

@enduml